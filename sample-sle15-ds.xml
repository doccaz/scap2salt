  <Rule id="xccdf_org.ssgproject.content_rule_dconf_gnome_screensaver_idle_delay" severity="medium">
    <title>Set GNOME3 Screensaver Inactivity Timeout</title>
    <reference href="https://docs-prv.pcisecuritystandards.org/PCI-DSS-v4_0.pdf">8.6.1</reference>
    <fix system="urn:xccdf:fix:script:sh">
DCONFFILE="/etc/dconf/db/local.d/00-security-settings"
DBDIR="/etc/dconf/db/local.d"
mkdir -p "${DBDIR}"
[ ! -z "${DCONFFILE}" ] &amp;&amp; echo "" >> "${DCONFFILE}"
if ! grep -q "\[org/gnome/desktop/session\]" "${DCONFFILE}"
then
    printf '%s\n' "[org/gnome/desktop/session]" >> ${DCONFFILE}
fi
escaped_value="$(sed -e 's/\\/\\\\/g' &lt;&lt;&lt; "uint32 900")"
if grep -q "^\s*idle-delay\s*=" "${DCONFFILE}"
then
    sed -i "s/\s*idle-delay\s*=\s*.*/idle-delay=${escaped_value}/g" "${DCONFFILE}"
else
    sed -i "\|\[org/gnome/desktop/session\]|a\idle-delay=${escaped_value}" "${DCONFFILE}"
fi
dconf update
echo "/org/gnome/desktop/session/idle-delay" >> "/etc/dconf/db/local.d/locks/00-security-settings-lockdown"
    </fix>
  </Rule>
