  <Rule id="xccdf_org.ssgproject.content_rule_kernel_module_usb_storage_disabled" severity="medium">
    <title>Disable Mounting of usb-storage</title>
    <reference href="https://docs-prv.pcisecuritystandards.org/PCI-DSS-v4_0.pdf">9.4.1</reference>
    <fix system="urn:xccdf:fix:script:sh">
