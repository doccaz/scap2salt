  <Rule id="xccdf_org.ssgproject.content_rule_accounts_maximum_age_login_defs" severity="medium">
    <title>Set Password Maximum Age</title>
    <reference href="https://docs-prv.pcisecuritystandards.org/PCI-DSS-v4_0.pdf">8.3.9</reference>
    <fix system="urn:xccdf:fix:script:sh">
if [ -e "/etc/login.defs" ] ; then
    LC_ALL=C sed -i "/^\s*PASS_MAX_DAYS\s/Id" "/etc/login.defs"
else
    touch "/etc/login.defs"
fi
printf '%s\n' "PASS_MAX_DAYS 90" >> "/etc/login.defs"
    </fix>
  </Rule>

  <Rule id="xccdf_org.ssgproject.content_rule_audit_rules_dac_modification_chmod" severity="medium">
    <title>Record Events that Modify DAC via chmod</title>
    <reference href="https://docs-prv.pcisecuritystandards.org/PCI-DSS-v4_0.pdf">10.2.1</reference>
    <fix system="urn:xccdf:fix:script:sh">
for ARCH in "${RULE_ARCHS[@]}"
do
    ACTION_ARCH_FILTERS="-a always,exit -F arch=$ARCH"
    OTHER_FILTERS="-F perm=x"
    AUID_FILTERS="-F auid>=1000 -F auid!=unset"
    SYSCALL="chmod fchmod fchmodat"
    KEY="perm_mod"
done
    </fix>
  </Rule>

