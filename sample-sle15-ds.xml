  <Rule id="xccdf_org.ssgproject.content_rule_sysctl_net_ipv4_conf_all_rp_filter" severity="medium">
    <title>Enable Kernel Parameter rp_filter on all IPv4 Interfaces</title>
    <reference href="https://docs-prv.pcisecuritystandards.org/PCI-DSS-v4_0.pdf">1.4.1</reference>
    <fix system="urn:xccdf:fix:script:sh">
sysctl_value="1"
if [ -z "$(grep -P '^\s*net.ipv4.conf.all.rp_filter' /etc/sysctl.conf)" ] ; then :; fi
/sbin/sysctl -q -n -w net.ipv4.conf.all.rp_filter="1"
printf '%s\n' "net.ipv4.conf.all.rp_filter = 1" >> /etc/sysctl.d/net_ipv4_conf_all_rp_filter.conf
    </fix>
  </Rule>

  <Rule id="xccdf_org.ssgproject.content_rule_package_telnet_removed" severity="high">
    <title>Remove telnet Package</title>
    <reference href="https://docs-prv.pcisecuritystandards.org/PCI-DSS-v4_0.pdf">2.2.4</reference>
    <fix system="urn:xccdf:fix:script:sh">
if rpm -q --quiet "telnet" ; then
    zypper remove -y "telnet"
fi
    </fix>
  </Rule>

  <Rule id="xccdf_org.ssgproject.content_rule_service_auditd_enabled" severity="medium">
    <title>Enable auditd Service</title>
    <reference href="https://docs-prv.pcisecuritystandards.org/PCI-DSS-v4_0.pdf">10.2.1</reference>
    <fix system="urn:xccdf:fix:script:sh">
SYSTEMCTL_EXEC='/usr/bin/systemctl'
"$SYSTEMCTL_EXEC" unmask 'auditd.service'
"$SYSTEMCTL_EXEC" start 'auditd.service'
"$SYSTEMCTL_EXEC" enable 'auditd.service'
    </fix>
  </Rule>

