# Optional SSH allow-lists (satisfy sshd_limit_user_access). Leave empty for
# unrestricted logins; enter space-separated names in the MLM form.
{%- set sshd_ag = ((p.get('sshd_allow_groups', '') or '') | string | regex_replace('[^A-Za-z0-9_.@ -]', '')).strip() %}
{%- set sshd_au = ((p.get('sshd_allow_users', '') or '') | string | regex_replace('[^A-Za-z0-9_.@ -]', '')).strip() %}
{%- if sshd_ag %}
sshd_AllowGroups:
  file.replace:
    - name: /etc/ssh/sshd_config
    - pattern: "^AllowGroups\\s.*$"
    - repl: {{ ('AllowGroups ' ~ sshd_ag) | tojson }}
    - append_if_not_found: True
    - backup: False
    - onlyif: {{ ('for x in ' ~ sshd_ag ~ '; do getent group "$x" >/dev/null && exit 0; done; exit 1') | tojson }}
sshd_AllowGroups_check:
  cmd.run:
    - name: "echo 'sshd AllowGroups: none of the listed names exist; restriction NOT applied' >&2; exit 1"
    - unless: {{ ('for x in ' ~ sshd_ag ~ '; do getent group "$x" >/dev/null && exit 0; done; exit 1') | tojson }}
{%- endif %}
