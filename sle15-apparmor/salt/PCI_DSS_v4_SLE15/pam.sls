# xccdf_org.ssgproject.content_rule_ensure_pam_wheel_group_empty
# Ensure the Group Used by pam_wheel.so Module Exists on System and is Empty  [severity: medium]
# PCI-DSS: 2.2.6, 2.2
pam_wheel_group_sugroup:
  group.present:
    - name: sugroup

pam_wheel_group_sugroup_empty:
  cmd.run:
    - name: "gpasswd -M '' sugroup"
    - onlyif: "getent group sugroup | awk -F: '$4 != \"\" {f=1} END {exit !f}'"
    - require:
        - group: pam_wheel_group_sugroup

