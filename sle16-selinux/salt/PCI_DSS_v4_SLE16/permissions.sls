  cmd.run:
    - name: "G=$(awk -F= '/^log_group/ {gsub(/ /,\"\",$2); print $2}' /etc/audit/auditd.conf 2>/dev/null); [ -n \"$G\" ] || G=root; chown root:$G /var/log/audit; find /var/log/audit -maxdepth 1 -type f -name 'audit.log*' -exec chown root:$G {} +"
